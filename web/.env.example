# ── Gridsight Client – Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.

# ── Authentication ─────────────────────────────────────────────────────────────
# Credentials used by the Bun server to validate login requests.
ADMIN_USER=admin
ADMIN_PASS=changeme

# Secret used to sign session tokens (use a long random string in production).
SESSION_SECRET=change-me-to-a-long-random-secret

# ── Backend ────────────────────────────────────────────────────────────────────
# URL of the Python (Flask/FastAPI) backend server.
BACKEND_URL=http://127.0.0.1:5001

# API key forwarded to the backend as the X-MyApp-ApiKey header.
API_KEY=TEST_KEY

# ── Server Ports ───────────────────────────────────────────────────────────────
# Port the Bun API/auth server listens on.
BUN_PORT=3001

# Port Vite dev server listens on (development only).
# VITE_PORT=5173

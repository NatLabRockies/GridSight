{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GridSight",
  "version": "1.0.0",
  "identifier": "gov.nlr.gridsight",
  "build": {
    "beforeDevCommand": "cd ../web && bunx vite --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../web && bun run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GridSight",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server",
      "resources/wheels",
      "resources/requirements.txt",
      "binaries/uv*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

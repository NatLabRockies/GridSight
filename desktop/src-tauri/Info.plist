<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required so the webview can use getUserMedia to scan a wall's join QR
       (Tab Sync → Remote → Scan). macOS shows its camera prompt the first
       time and refuses access without this string. -->
  <key>NSCameraUsageDescription</key>
  <string>Meridian uses the camera to scan a QR code when joining a remote session.</string>
</dict>
</plist>

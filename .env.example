# ─────────────────────────────────────────────────────────────────────────────
# GridSight — environment variables for docker-compose.
#
# Copy this file to `.env` and fill in real values for the deployment.
# `.env` is read automatically by `docker compose up` and forwarded into
# both the server and web containers via `env_file:` in compose.
#
# Extension-specific variables also live in this file. Each extension
# documents the vars it expects in its own README; just append them
# below. Anything declared here is forwarded into the server container
# verbatim, so adding a new extension's DB credentials is a config-only
# change — no Dockerfile or compose edits needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image selection ────────────────────────────────────────────────────────
# Tag both `gridsight-server` and `gridsight-web` images get pulled at.
# Pinned to a real tag (v1.2.3, git sha) in production; defaults to
# `local` for build-and-run-locally workflows.
IMAGE_TAG=local

# Host port the web container listens on (mapped to BUN_PORT inside).
WEB_PORT=3001

# ── Server core ────────────────────────────────────────────────────────────
# Auth between Bun proxy and Python backend. Match what the web container
# sends as X-MyApp-ApiKey.
API_KEY=change-me

# ── Persistent state ──────────────────────────────────────────────────────
# DB_PATH and GAT_DB_PATH each accept either a local filesystem path or
# an `s3://bucket/key` URI. With an S3 URI the helper downloads the
# object on startup (if it exists) into STORAGE_CACHE_DIR (default
# $DATA_DIR/_s3_cache, or /tmp/_s3_cache if DATA_DIR isn't set) and
# uploads it back on shutdown. Single-replica deployments only — a
# SIGKILL bypasses the upload, so SIGTERM grace must be generous
# enough to flush.
#
# Credentials follow the standard AWS chain: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_REGION, IRSA on EKS, instance role, or
# ~/.aws/credentials. Override the endpoint for non-AWS S3 with
# AWS_ENDPOINT_URL_S3 (or AWS_ENDPOINT_URL as a fallback).
#
# DB_PATH=/data/gridsight.db
# DB_PATH=s3://gridsight-state/prod/gridsight.db
#
# GAT_DB_PATH=/data/gat/gat_server.duckdb
# GAT_DB_PATH=s3://gridsight-state/prod/gat_server.duckdb
#
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-west-2
# AWS_ENDPOINT_URL_S3=http://seaweedfs:8333  # local SeaweedFS
# STORAGE_CACHE_DIR=/data/_s3_cache

# AI providers. Set whatever keys you have; missing ones fall through.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# XAI_API_KEY=xai-...
# AWS_BEDROCK_API_KEY=...

# Local LLM (Ollama). Defaults work if Ollama is reachable from the
# server container's network.
LLM_MODEL=gpt-oss:20B
OLLAMA_URL=http://host.docker.internal:11434

# Custom OpenAI-compatible LLM (e.g. a self-hosted LiteLLM or vLLM proxy).
# Enables the "Custom (OpenAI-compatible)" provider. The server talks to it
# with the `openai` client library directly (NOT the litellm package). Keep
# the endpoint private and protect it with an API key.
#   CUSTOM_LLM_BASE_URL=https://llm.example.org/v1
#   CUSTOM_LLM_API_KEY=sk-...
#   # Restrict the model picker. MODEL_FILTER is a regex/substring matched
#   # against model names (empty = no filter). MODELS is an optional
#   # explicit, comma-separated allowlist.
#   CUSTOM_LLM_MODEL_FILTER=
#   # CUSTOM_LLM_MODELS=model-a,model-b
#   # Cap thinking time: low | medium | high
#   CUSTOM_LLM_REASONING_EFFORT=low

LOG_LEVEL=info

# ── Web (Bun proxy) ────────────────────────────────────────────────────────
# Operator login that the Bun proxy gates the UI on.
ADMIN_USER=admin
ADMIN_PASS=changeme

# Used to sign session cookies. Set to a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to `true` only when serving over HTTPS — otherwise the browser
# silently drops the session cookie.
SECURE_COOKIE=false

# ── Extension-specific ────────────────────────────────────────────────────
# Add the env vars each enabled extension declares it needs. Examples
# below — comment them in as relevant.
#
# DemandTldr — data sourcing (precedence: DATA_DIR > S3 > packaged samples):
#
#   # 1. Explicit path (PVC / init-container / host mount). Skipped if not populated.
#   # DEMANDTLDR_DATA_DIR=/data/demand-tldr
#
#   # 2. S3 sync at startup. Files are downloaded into DEMANDTLDR_CACHE_DIR
#   #    (default /tmp/demand_tldr_data) and re-used on subsequent restarts
#   #    of the same pod. Set DEMANDTLDR_S3_REFRESH=1 to force re-download.
#   # DEMANDTLDR_S3_URI=s3://gridsight/demand-tldr/v1/
#   # DEMANDTLDR_S3_ACCESS_KEY=...        # falls back to AWS_* / IRSA / instance role
#   # DEMANDTLDR_S3_SECRET_KEY=...
#   # DEMANDTLDR_S3_REGION=us-west-2
#   # DEMANDTLDR_S3_ENDPOINT_URL=https://s3.example.internal   # for non-AWS S3
#   # DEMANDTLDR_CACHE_DIR=/data/demand-tldr-cache
#   # DEMANDTLDR_S3_REFRESH=0
#
#   # ── Local SeaweedFS preset (drop-in for testing the S3 flow) ─────
#   # Bring up the local S3 with `docker compose --profile s3-local up`,
#   # then seed it once via `./scripts/seed-local-s3.sh`. The server
#   # reaches SeaweedFS at the compose hostname; from the host CLI it's
#   # http://localhost:8333.
#   # DEMANDTLDR_S3_URI=s3://gridsight/demand-tldr/v1/
#   # DEMANDTLDR_S3_ACCESS_KEY=gridsight-local
#   # DEMANDTLDR_S3_SECRET_KEY=gridsight-local-secret
#   # DEMANDTLDR_S3_REGION=us-east-1
#   # DEMANDTLDR_S3_ENDPOINT_URL=http://seaweedfs:8333
#
# GAT — paths the extension reads/writes:
#
#   # Scenario DuckDB. Holds every uploaded scenario's tables. Accepts
#   # local paths (back the directory with a PVC for k8s persistence)
#   # or s3:// URIs (round-tripped via resolve_path on graceful start
#   # / stop; gzip in flight if the key ends with .gz). Default in
#   # dev is ~/.gat/server/gat_server.duckdb; in containers, point it
#   # somewhere that survives pod restarts.
#   # GAT_DB_PATH=/data/gat/gat_server.duckdb
#   # GAT_DB_PATH=s3://gridsight/GAT/gat_server.duckdb.gz
#
#   # Root for uploaded scenario artefacts (system JSON + HDF5 sims).
#   # Backend-neutral — operators pick whichever storage they have:
#   #   - local dir / NFS / SMB / PVC mount: any filesystem path
#   #   - S3 / SeaweedFS:                     s3://bucket/prefix
#   # Layout under the root is always {project}/{scenario}/{filename};
#   # files are gzipped when the root is on S3 and stored raw on
#   # local mounts. Default sits next to GAT_DB_PATH so a single
#   # mount point covers both.
#   # GAT_DATA_ROOT=/data/gat/scenarios
#   # GAT_DATA_ROOT=s3://gridsight/GAT
#
#   # Legacy fallback search dir for system JSONs uploaded outside
#   # the gridsight flow (developer workstations with sibling repos).
#   # GAT_DATA_PATH=/data/gat/system-files
